# Render environment variables example
# Copy to a secure location and fill with real values when deploying.

# Backend
ADMIN_TOKEN=dev-admin-token
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
KNOWLEDGE_BASE_PATH=AI智慧應用產業人才培訓班_整合知識庫.txt

# Database
# Render provides a DATABASE_URL for the managed Postgres instance
DATABASE_URL=

# Embedding / vector store
VECTOR_STORE_TYPE=local
EMBEDDING_MODEL=

# Frontend
VITE_API_BASE=
